{
  "name": "@furlpay/instagram-mcp",
  "version": "0.1.0",
  "description": "Professional Instagram account tools for MCP clients with OAuth and human write approval",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.0.0" },
  "bin": { "furlpay-instagram-mcp": "dist/cli.js" },
  "files": ["dist", "docs", "README.md", "LICENSE", ".env.example"],
  "repository": { "type": "git", "url": "https://github.com/FurlPay/furlpay-instagram-mcp.git" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/unit.test.ts test/oauth.test.ts",
    "test:integration": "tsx --test test/integration.test.ts test/transport.test.ts",
    "docs:generate": "node scripts/tool-docs.mjs",
    "docs:check": "node scripts/tool-docs.mjs --check",
    "start": "node dist/cli.js serve",
    "connect": "node dist/cli.js connect",
    "approve": "node dist/cli.js approve",
    "disconnect": "node dist/cli.js disconnect",
    "status": "node dist/cli.js status",
    "http": "node dist/cli.js http"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.30.1", "zod": "^3.25.76" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.3", "tsx": "^4.20.6", "eslint": "^9.39.1", "typescript-eslint": "^8.46.0" }
}
