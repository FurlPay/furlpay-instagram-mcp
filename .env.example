# Copy to .env; never commit the populated file. Node 24+ is required.
INSTAGRAM_API_PRODUCT=facebook_login
META_GRAPH_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
# Generate with: node dist/cli.js keygen. Inject via your deployment secret manager.
TOKEN_ENCRYPTION_KEY=
# Optional; default is ~/.furlpay-instagram/state.sqlite (outside this checkout).
# INSTAGRAM_DATABASE_PATH=/var/lib/furlpay-instagram/state.sqlite
# Register this exact callback in Meta. Connect runs an operator-only loopback listener.
INSTAGRAM_REDIRECT_URI=http://localhost:8787/oauth/callback
# Required if the user can manage more than one Page:
# FACEBOOK_PAGE_ID=
# Set when your Facebook Login for Business setup uses a configuration (User token type):
# FACEBOOK_LOGIN_CONFIG_ID=
# Core defaults. Request only permissions approved for the app and needed by the deployment.
INSTAGRAM_SCOPES=instagram_basic,pages_show_list,pages_read_engagement,instagram_content_publish,instagram_manage_comments,instagram_manage_insights
# Optional scopes: instagram_manage_contents,instagram_manage_engagement,
# instagram_manage_messages,pages_manage_metadata,pages_messaging,ads_read
# Hashtag discovery additionally needs Instagram Public Content Access (an App Review feature).

# Optional authenticated Streamable HTTP and webhook receiver:
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8788
# Required for HTTP; independent random secret, minimum 32 characters.
# MCP_HTTP_BEARER_TOKEN=
# External HTTPS origin for strict Host/Origin checks behind a reverse proxy, no trailing slash:
# MCP_ALLOWED_ORIGIN=https://instagram-mcp.example.com
# Independent random value configured in Meta's webhook verification screen:
# META_WEBHOOK_VERIFY_TOKEN=
# A working human contact/escalation page is mandatory before using the send-message tool:
# INSTAGRAM_HUMAN_SUPPORT_URL=https://furlpay.com/support
